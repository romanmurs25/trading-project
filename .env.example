APP_ENV=local
TRADING_MODE=RESEARCH
ALLOW_LIVE_TRADING=false

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/trading
REDIS_URL=redis://localhost:6379/0

DEFAULT_TIMEZONE=UTC
EXCHANGE_TIMEZONE=Europe/Moscow

MOEX_ISS_BASE_URL=https://iss.moex.com/iss

TINVEST_TOKEN=
TINVEST_ACCOUNT_ID=
TINVEST_SANDBOX=true

BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_TESTNET=true
BYBIT_RECV_WINDOW=5000

RISK_MAX_RISK_PER_TRADE_PCT=0.25
RISK_MAX_DAILY_LOSS_PCT=1.0
RISK_MAX_WEEKLY_LOSS_PCT=3.0
RISK_MAX_OPEN_POSITIONS=3
RISK_MAX_POSITION_SIZE=10
RISK_MAX_NOTIONAL_EXPOSURE=100000
RISK_MAX_ORDER_QTY=10
RISK_MAX_SPREAD_BPS=10
RISK_STALE_DATA_SECONDS=10
RISK_ALLOW_MARKET_ORDERS_LIVE=false
RISK_ALLOW_AVERAGING_DOWN=false
RISK_ALLOW_REDUCE_ONLY_WHEN_KILLED=true
